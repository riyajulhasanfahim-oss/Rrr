# Global Security & Browser Headers
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-XSS-Protection: 1; mode=block

# API Endpoints - STRICT ZERO CACHE FOR CLOUDFLARE EDGE & BROWSER
/api/*
  Cache-Control: private, no-cache, no-store, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, POST, PUT, DELETE, PATCH, OPTIONS
  Access-Control-Allow-Headers: Origin, X-Requested-With, Content-Type, Accept, Authorization, X-App-Source, Cache-Control, Pragma

# Static Assets - Long Cache with Invalidation Hashes
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: max-age=31536000
  Cloudflare-CDN-Cache-Control: max-age=31536000

# HTML Entry Point - Always Revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: max-age=0, must-revalidate
  Cloudflare-CDN-Cache-Control: max-age=0, must-revalidate
